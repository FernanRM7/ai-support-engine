{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-support-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": { "AI_GATEWAY_ID": "default", "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct" }
}
